# Source this file only after replacing HF_TOKEN. Never commit the copy.
HF_TOKEN=hf_replace_me
# Leave empty to accept unauthenticated STT requests on a trusted LAN.
STT_API_TOKEN=
STT_HOST=0.0.0.0
STT_PORT=8100
STT_STATE_DIR=./var/cuda-stt
# Use cuda or an explicit GPU such as cuda:0.
STT_DEVICE=cuda
# Use cuda for faster diarization, or cpu to reserve GPU memory for Whisper.
STT_DIARIZATION_DEVICE=cuda
STT_BATCH_SIZE=1
STT_PROGRESS_INTERVAL_SECONDS=30
# Log and expose real model chunk counts every 10 or 100 completed chunks.
STT_CHUNK_PROGRESS_EVERY=10
# Higher values reject more low-confidence voice activity. Must be positive.
STT_NOISE_FILTER_TRIGGER_LEVEL=7.0

# Optional isolated WhisperX backend. Requests select it with
# options={"backend":"whisperx",...}; Kotoba remains the default.
WHISPERX_PYTHON=./.venv-whisperx/bin/python
WHISPERX_MODEL=large-v3
WHISPERX_LANGUAGE=ja
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_CACHE_DIR=./var/cuda-cache/whisperx
