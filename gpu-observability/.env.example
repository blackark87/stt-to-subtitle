# Bind administrative UIs to loopback by default. Change only behind a trusted proxy.
BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
DCGM_EXPORTER_PORT=9400

# Replace before starting the stack. Do not commit the populated .env file.
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Immutable component versions reviewed for this standalone project.
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.3-distroless
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
GRAFANA_IMAGE=grafana/grafana:13.1.0
