# syntax=docker/dockerfile:1

ARG PYTHON_IMAGE=python:3.11.15-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba
ARG STT_RUNTIME_BASE_IMAGE=stt-to-subtitle-runtime-base:py311-cuda-v4

FROM ${PYTHON_IMAGE} AS service-source

WORKDIR /build
COPY src ./src
COPY scripts/build_service_package.py ./scripts/build_service_package.py
RUN python scripts/build_service_package.py \
    runtime src/stt_to_subtitle /service/stt_to_subtitle

FROM ${STT_RUNTIME_BASE_IMAGE} AS runtime

ARG APP_UID=1000
ARG APP_GID=1000

ENV PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venvs/kotoba/bin:$PATH \
    PYTHONPATH=/opt/stt \
    HF_HOME=/var/cache/stt/huggingface \
    PYANNOTE_CACHE=/var/cache/stt/pyannote \
    TORCH_HOME=/var/cache/stt/torch \
    WHISPERX_CACHE_DIR=/var/cache/stt/whisperx \
    WHISPERX_PYTHON=/opt/venvs/whisperx/bin/python \
    WHISPERJAV_PYTHON=/opt/venvs/whisperjav/bin/python \
    STT_STATE_DIR=/var/lib/stt \
    STT_DEVICE=cuda \
    STT_DIARIZATION_DEVICE=cuda

RUN groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --no-create-home app \
    && mkdir -p /var/cache/stt /var/lib/stt /var/lib/stt-work \
    && chown -R app:app /var/cache/stt /var/lib/stt /var/lib/stt-work

COPY --from=service-source /service/stt_to_subtitle /opt/stt/stt_to_subtitle

RUN /opt/venvs/whisperjav/bin/python -c \
        "from stt_to_subtitle.vendor.whisperjav.runner import run_ensemble" \
    && ! /opt/venvs/whisperjav/bin/python -c "import whisperjav" 2>/dev/null

USER app
WORKDIR /app
EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/readyz', timeout=3)"]

ENTRYPOINT ["python", "-m", "stt_to_subtitle.runtime_api"]
