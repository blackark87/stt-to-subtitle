# Copy this file to .env.compose and replace the token before starting Compose.
WORKSPACE=.
MEDIA_PATH=./media
WEB_STATE_PATH=/data/stt-to-subtitle/web-state
WEB_PUID=1026
WEB_PGID=100
STT_STATE_PATH=/data/stt-to-subtitle/stt-state
MODEL_CACHE_PATH=/data/stt-to-subtitle/model
STT_RUNTIME_IMAGE=stt-to-subtitle-stt-runtime:py311-cuda-v1

# Existing Traefik Docker network and HTTPS route.
TRAEFIK_HOST=stt.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
WEB_FORWARDED_ALLOW_IPS=*

# Accept the gated Pyannote model terms, then provide a Hugging Face read token.
HF_TOKEN=hf_replace_me

# Leave these empty to disable the web login on a trusted private network.
WEB_ADMIN_PASSWORD=
WEB_SESSION_SECRET=
WEB_SECURE_COOKIE=true

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_TOKEN=
OPENAI_COMPATIBLE_MODEL=
