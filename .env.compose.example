# Copy this file to .env.compose and replace the token before starting Compose.
PUID=1000
PGID=1000
MEDIA_PATH=./media
WEB_STATE_PATH=./var/web-state
STT_STATE_PATH=./var/stt-state
MODEL_CACHE_PATH=./var/model-cache
WEB_PORT=8080

# Accept the gated Pyannote model terms, then provide a Hugging Face read token.
HF_TOKEN=hf_replace_me
# Leave empty to disable API authentication on a trusted private network.
STT_API_TOKEN=
STT_DEVICE=cuda
STT_DIARIZATION_DEVICE=cuda
STT_BATCH_SIZE=1
STT_PROGRESS_INTERVAL_SECONDS=30
STT_CHUNK_PROGRESS_EVERY=10
STT_NOISE_FILTER_TRIGGER_LEVEL=7.0
STT_DEBUG_ARTIFACTS=false
WHISPERX_MODEL=large-v3
WHISPERX_LANGUAGE=ja
WHISPERX_COMPUTE_TYPE=float16
NVIDIA_VISIBLE_DEVICES=all

# Leave these empty to disable the web login on a trusted private network.
WEB_ADMIN_PASSWORD=
WEB_SESSION_SECRET=
WEB_SECURE_COOKIE=false

# The web service uses the Compose STT service by default.
STT_BASE_URL=http://stt:8100

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_TOKEN=
OPENAI_COMPATIBLE_MODEL=
TRANSLATION_BATCH_SEGMENTS=30
TRANSLATION_BATCH_CHARACTERS=6000
