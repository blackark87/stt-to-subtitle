# Copy this file to .env.compose and replace the token before starting Compose.
WORKSPACE=.
MEDIA_PATH=./media
BACKEND_STATE_PATH=/var/lib/homelab/stt-to-subtitle/web-state
BACKEND_WORK_PATH=/data/work/stt-to-subtitle/web-jobs
BACKEND_PUID=1026
BACKEND_PGID=100
# The normally-off translation PC is contacted only by queued translation work.
STT_STATE_PATH=/var/lib/homelab/stt-to-subtitle/stt-state
STT_WORK_PATH=/data/work/stt-to-subtitle/stt-incoming
MODEL_CACHE_PATH=/data/models/stt-to-subtitle
STT_RUNTIME_CACHE_PATH=/data/cache/buildkit/stt-runtime-py311-cuda-v4-20260825
STT_RUNTIME_BASE_IMAGE=stt-to-subtitle-runtime-base:py311-cuda-v4
STT_RUNTIME_ID=builtin
STT_RUNTIME_NAME=기본 Runtime
STT_API_TOKEN=

# Existing Traefik Docker network and HTTPS route.
TRAEFIK_HOST=stt.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
BACKEND_FORWARDED_ALLOW_IPS=*

# Accept the gated Pyannote model terms, then provide a Hugging Face read token.
HF_TOKEN=hf_replace_me

# Concurrent ffmpeg extraction slots. Rendering runs on its own executor.
BACKEND_AUDIO_WORKERS=1

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_TOKEN=
OPENAI_COMPATIBLE_MODEL=

# Optional direct GPU telemetry from the standalone gpu-observability project.
# With compose.gpu-monitoring.yaml, the internal default is http://prometheus:9090.
GPU_PROMETHEUS_URL=
# Optional bearer token when Prometheus is protected by a trusted reverse proxy.
GPU_PROMETHEUS_TOKEN=
GPU_METRICS_REFRESH_SECONDS=10
GPU_METRICS_TIMEOUT_SECONDS=3
GPU_MONITORING_NETWORK=gpu-monitoring
