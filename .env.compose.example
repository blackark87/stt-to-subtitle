# Copy this file to .env.compose and replace the token before starting Compose.
WORKSPACE=.
MEDIA_PATH=./media
TRANSCRIPTION_AUDIO_PATH=./audio
BACKEND_PUID=1026
BACKEND_PGID=100
# Stable application addresses keep host-firewall rules valid after recreation.
APP_NETWORK_SUBNET=172.24.0.0/16
BACKEND_APP_IPV4=172.24.0.2
WEB_APP_IPV4=172.24.0.3
STT_API_TOKEN=
# Optional bootstrap Transcriber. Additional endpoints are managed in Settings.
STT_BASE_URL=

# Existing Traefik Docker network and HTTPS route.
TRAEFIK_HOST=stt.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
BACKEND_FORWARDED_ALLOW_IPS=*

# Concurrent ffmpeg extraction slots. Rendering runs on its own executor.
BACKEND_AUDIO_WORKERS=1

# Draft and review translation groups own independent server registries.
TRANSLATION_BUILTIN_NAME=기본 서버
TRANSLATION_BUILTIN_BASE_URL=
TRANSLATION_BUILTIN_TOKEN=
TRANSLATION_BUILTIN_CAPACITY=1
TRANSLATION_BUILTIN_DRAFT_ENABLED=true
TRANSLATION_BUILTIN_REVIEW_ENABLED=false
TRANSLATION_BUILTIN_DRAFT_BATCH_PREFERRED=false
TRANSLATION_BUILTIN_REVIEW_BATCH_PREFERRED=false
# Comma-separated Ollama hosts that share memory with the built-in Transcriber.
# Before local transcription, their active requests drain and loaded LLMs unload.
TRANSLATION_STT_HARD_BREAKER_HOSTS=
TRANSLATION_STT_HARD_BREAKER_TIMEOUT_SECONDS=600

# Optional GPU telemetry from the standalone gpu-observability project.
# Use http://host.docker.internal:9090 when Prometheus is host-published.
GPU_PROMETHEUS_URL=
# Optional bearer token when Prometheus is protected by a trusted reverse proxy.
GPU_PROMETHEUS_TOKEN=
GPU_METRICS_REFRESH_SECONDS=10
GPU_METRICS_TIMEOUT_SECONDS=3
