# syntax=docker/dockerfile:1

ARG NODE_IMAGE=node:24.11.1-alpine3.22

FROM ${NODE_IMAGE} AS deps
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,id=stt-web-npm,target=/root/.npm \
    npm ci --no-audit --no-fund

FROM ${NODE_IMAGE} AS builder
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /build
COPY --from=deps /build/node_modules ./node_modules
COPY web ./
RUN npm run build

FROM ${NODE_IMAGE} AS runtime

ARG APP_UID=1000
ARG APP_GID=1000

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# standalone 출력만 옮긴다. node_modules 전체를 싣지 않는다.
COPY --from=builder --chown=${APP_UID}:${APP_GID} /build/.next/standalone ./
COPY --from=builder --chown=${APP_UID}:${APP_GID} /build/.next/static ./.next/static

USER ${APP_UID}:${APP_GID}
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

ENTRYPOINT ["node", "server.js"]
