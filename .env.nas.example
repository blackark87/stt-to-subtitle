# Copy to .env.nas, replace the addresses/model, and keep it out of Git.
PUID=1000
PGID=1000
MEDIA_PATH=/volume1/media
STATE_PATH=./var/nas-state
NAS_WEB_PORT=8080
NAS_IMAGE=stt-to-subtitle:nas

# Leave these empty to disable the NAS web login on a trusted LAN.
NAS_ADMIN_PASSWORD=
NAS_SESSION_SECRET=
NAS_SECURE_COOKIE=false

STT_BASE_URL=http://192.168.1.20:8100
# Leave empty when the Mac STT API also has STT_API_TOKEN unset.
STT_API_TOKEN=

LM_STUDIO_BASE_URL=http://192.168.1.30:1234/v1
# Leave empty when LM Studio authentication is disabled.
LM_STUDIO_TOKEN=
LM_STUDIO_MODEL=replace-with-the-loaded-model-identifier

TRANSLATION_BATCH_SEGMENTS=30
TRANSLATION_BATCH_CHARACTERS=6000
