# Copy to .env.nas and keep it out of Git. Server values below are only
# initial defaults; they can be changed later from the NAS web settings page.
PUID=1000
PGID=1000
MEDIA_PATH=/volume1/media
STATE_PATH=./var/nas-state
NAS_WEB_PORT=8080
NAS_IMAGE=ghcr.io/blackark87/stt-to-subtitle:nas-latest

# Leave these empty to disable the NAS web login on a trusted LAN.
NAS_ADMIN_PASSWORD=
NAS_SESSION_SECRET=
NAS_SECURE_COOKIE=false

STT_BASE_URL=
# Leave empty when the Mac STT API also has STT_API_TOKEN unset.
STT_API_TOKEN=

LM_STUDIO_BASE_URL=
# Leave empty when LM Studio authentication is disabled.
LM_STUDIO_TOKEN=
LM_STUDIO_MODEL=

TRANSLATION_BATCH_SEGMENTS=30
TRANSLATION_BATCH_CHARACTERS=6000
