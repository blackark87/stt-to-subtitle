# Source this file only after replacing HF_TOKEN. Never commit the copy.
HF_TOKEN=hf_replace_me
# Leave empty to accept unauthenticated STT requests on a trusted LAN.
STT_API_TOKEN=
STT_HOST=0.0.0.0
STT_PORT=8100
STT_STATE_DIR=./var/stt
STT_DEVICE=mps
STT_DIARIZATION_DEVICE=cpu
# Kotoba pipeline batch size. Fixed when the pipeline loads.
# Compose defaults to 8 for CUDA; 1 stays the safe value for CPU and MPS hosts.
STT_BATCH_SIZE=1
# CPU threads for Torch and the WhisperX worker. Leave empty for framework defaults.
STT_THREADS=
# Batch size for the whisperx and hybrid backends only.
WHISPERX_BATCH_SIZE=8
STT_PROGRESS_INTERVAL_SECONDS=30
# Log and expose real model chunk counts every 10 or 100 completed chunks.
STT_CHUNK_PROGRESS_EVERY=10
# Hand the resident Kotoba model's VRAM back after this many idle seconds.
# 0 releases as soon as the queue drains; a negative value keeps it loaded forever.
# WhisperX and WhisperJAV run as subprocesses and already free their VRAM on exit.
STT_MODEL_IDLE_TIMEOUT_SECONDS=900
# Higher values reject more low-confidence voice activity. Must be positive.
STT_NOISE_FILTER_TRIGGER_LEVEL=7.0
# Off by default because stage JSON can contain sensitive transcript text.
STT_DEBUG_ARTIFACTS=false
# Optional; defaults to STT_STATE_DIR/artifacts when debugging is enabled.
STT_DEBUG_ARTIFACTS_DIR=
